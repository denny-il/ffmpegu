{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": false,
	"tabWidth": 2,
	"printWidth": 80,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"quoteProps": "as-needed",
	"trailingComma": "none",
	"semi": false,
	"arrowParens": "always",
	"bracketSameLine": false,
	"bracketSpacing": true,
	"ignorePatterns": [],
	"overrides": [
		{
			"files": ["*.json", "*.jsonc"],
			"options": { "useTabs": true }
		}
	]
}
